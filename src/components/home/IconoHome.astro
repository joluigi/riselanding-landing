---
// Íconos Lucide que solo usa la home (maqueta de flujo y leyenda) y que src/components/ui/Icono.astro
// no trae. Mismo trazo y clases .icon de componentes.css. Si otra página los necesita, conviene
// moverlos a Icono.astro (componente compartido de PR1).
type Nombre = 'info' | 'file' | 'filter' | 'database' | 'bell';

interface Props {
  nombre: Nombre;
  tamano?: 'sm' | 'md';
}

const { nombre, tamano = 'md' } = Astro.props;

// Lucide, licencia ISC
const TRAZOS: Record<Nombre, string> = {
  info: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>',
  file: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/>',
  filter: '<polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>',
  database: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/>',
  bell: '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>'
};
---
<svg class:list={['icon', tamano === 'sm' && 'icon--sm']} viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={TRAZOS[nombre]} />
