---
// Motion de la home (DESIGN.md §10): una entrada por sección (.reveal), solo opacidad y 8 px de
// desplazamiento, con --duration-slow y --ease-out. Con prefers-reduced-motion los tokens valen 0 ms.
// Sin JS no se oculta nada. Al cargar, solo se ocultan las secciones que están debajo del pliegue,
// así lo que ya está en pantalla no parpadea. El hero no lleva .reveal (H1 y maqueta son el LCP).
---
<script>
  const pendientes = Array.from(document.querySelectorAll<HTMLElement>('.reveal')).filter(
    (el) => el.getBoundingClientRect().top > window.innerHeight
  );
  if (pendientes.length && 'IntersectionObserver' in window) {
    const observador = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((en) => {
          if (!en.isIntersecting) return;
          en.target.classList.remove('reveal--pendiente');
          observador.unobserve(en.target);
        });
      },
      { rootMargin: '0px 0px -10% 0px' }
    );
    pendientes.forEach((el) => {
      el.classList.add('reveal--pendiente');
      observador.observe(el);
    });
  }
</script>
