---
// Tarjeta (DESIGN.md §7): --color-surface, --radius-md, --shadow-1, padding 32 (móvil 24).
// Uso: <Tarjeta as="li" class="step">...</Tarjeta>
interface Props {
  as?: 'div' | 'article' | 'section' | 'li' | 'aside';
  id?: string;
  class?: string;
  [atributo: string]: unknown;
}
const { as: Etiqueta = 'div', class: clase, ...resto } = Astro.props;
---
<Etiqueta class:list={['card', clase]} {...resto}><slot /></Etiqueta>
