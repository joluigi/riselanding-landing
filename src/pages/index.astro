---
// Home (docs/wireframes/home.md, prototipo variante A). Orden: hero con pestañas, herramientas,
// por qué Riselanding y equipo, servicios (#servicios, dispara rl_service_view), proceso, FAQ y
// #contacto con el formulario sin servicio precargado. El diagnóstico de madurez llega en la ola 2.
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Herramientas from '../components/home/Herramientas.astro';
import Nosotros from '../components/home/Nosotros.astro';
import Servicios from '../components/home/Servicios.astro';
import Proceso from '../components/home/Proceso.astro';
import PreguntasFrecuentes from '../components/home/PreguntasFrecuentes.astro';
import Aparicion from '../components/home/Aparicion.astro';
import Contacto from '../components/forms/Contacto.astro';
import { TITULO, DESCRIPCION, PREGUNTAS } from '../components/home/contenido.js';
import { WHATSAPP_URL, CORREO } from '../data/servicios.js';
import '../styles/home.css';

const SITIO = 'https://riselanding.com';

// Solo datos confirmados: sin sameAs ni teléfono fijo hasta que José responda la pregunta 2
// del cuestionario (docs/copy/pendientes-home.md).
const organizacion = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': SITIO + '/#organization',
  name: 'Riselanding',
  url: SITIO,
  logo: {
    '@type': 'ImageObject',
    url: SITIO + '/Assets/logo-horizontal.png',
    width: 640,
    height: 296
  },
  image: SITIO + '/Assets/og-image.png',
  description: 'Campañas, CRM, automatización y medición para empresas B2B en México, operados por un solo equipo.',
  areaServed: { '@type': 'Country', name: 'México', identifier: 'MX' },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    telephone: '+52-55-4821-3439',
    url: WHATSAPP_URL,
    email: CORREO,
    areaServed: 'MX',
    availableLanguage: 'es'
  }
};

const preguntasFrecuentes = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: PREGUNTAS.map((p) => ({
    '@type': 'Question',
    name: p.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: p.respuesta }
  }))
};
---
<Base
  title={TITULO}
  description={DESCRIPCION}
  path="/"
  tracking={{ template: 'home_v2', type: 'home', serviceLine: 'paquete_integral' }}
  jsonLd={[organizacion, preguntasFrecuentes]}
  formulario={true}
  barraCta={true}
>
  <main id="contenido" class="home">
    <Hero />
    <Herramientas />
    <Nosotros />
    <Servicios />
    <Proceso />
    <PreguntasFrecuentes />
    <Contacto servicio={null} />
  </main>
  <Aparicion />
</Base>
