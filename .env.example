# Variables de entorno de riselanding.com (Vercel → Settings → Environment Variables).
# Copia este archivo a .env.local para desarrollo local. NUNCA hagas commit de valores reales.
# Todo cambio de variable en Vercel requiere Redeploy para aplicarse.

# --- Destino del lead (api/lead.js) ---
# Webhook de n8n que recibe el lead. Secreto: no exponer en el cliente.
N8N_WEBHOOK_URL=https://example.invalid/webhook/lead-capture-REEMPLAZAR
# Valor del header x-form-secret que n8n exige (Header Auth del nodo Webhook).
FORM_SHARED_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio

# --- Token de formulario (api/form-token.js + api/lead.js) ---
# Firma HMAC-SHA256 del token con el instante de render. Sin ella, la capa de token
# y tiempo mínimo queda desactivada (warning en el log). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FORM_TOKEN_SECRET=reemplazar-por-32-bytes-aleatorios

# --- Cloudflare Turnstile (modo Managed) ---
# Las DOS deben existir; con solo una, la capa se apaga completa (warning en el log).
# La site key es pública (la entrega /api/form-token); la secret key no.
TURNSTILE_SITE_KEY=0x0000000000000000000000
TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000000

# --- Solicitantes no comerciales (api/lead.js) ---
# Correo que se muestra a proveedores/agencias ("Soy proveedor o agencia…"). Opcional:
# si no existe, el mensaje no incluye correo.
VENDOR_CONTACT_EMAIL=proveedores@example.invalid

# --- Modo del gate de calidad (api/lead.js) ---
# shadow (por defecto): el motor evalúa y etiqueta, pero TODO lo que evalúa se reenvía a n8n
#   (con " · Calidad: flag/tier score" al final de las notas).
# enforce: spam y competitor (agency-denylist) NO se reenvían; suspect y clean sí.
# Rechazos duros (honeypot, token, Turnstile) y no comerciales autodeclarados nunca se reenvían.
LEAD_GATE_MODE=shadow
